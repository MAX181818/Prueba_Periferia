# Copia como .env. No publiques ese archivo ni pegues claves en el chat.
PORT=3000
HOST=127.0.0.1
# Modelo real local con Ollama. No necesita clave ni cuenta de proveedor.
# npm run local inicia Ollama y el chat en Windows.
LLM_MODE=ollama
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=16384
# Solo se utilizan en modo openai. En ollama no se envía ninguna clave.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
MAX_ITERATIONS=12
# Presupuesto conservador: bytes UTF-8 de entrada + reserva de salida por envío.
# Acumulado por sesión y por proceso; no equivale a tokens facturados.
MAX_SESSION_TOKENS=400000
MAX_GLOBAL_TOKENS=1000000
MAX_COMPLETION_TOKENS=1500
# Opcional: por defecto 120000 para Ollama y 30000 para OpenAI.
# LLM_TIMEOUT_MS=120000
